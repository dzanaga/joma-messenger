<?xml version="1.0" encoding="utf-8"?>
<!-- joma: Jami Android's base theme (app/src/main/res/values/styles.xml, Copyright
     Savoir-faire Linux, GPL-3.0) with the terminal font everywhere. A flavor's style
     replaces main's whole, so AppThemeBase is repeated here with Joma's additions at
     the end; keep it in step when Jami's changes. -->
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="AppThemeBase" parent="@style/Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorControlNormal">@color/icon_color</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:editTextColor">@color/colorOnSurface</item>
        <item name="android:textColorSecondary">@color/colorOnSecondaryContainer</item>

        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorSecondary</item>
        <item name="colorOnPrimary">@color/background</item>
        <item name="colorPrimaryContainer">@color/colorPrimary</item>
        <item name="colorOnPrimaryContainer">@color/background</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondaryContainer</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/colorPrimary</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        <item name="colorPrimaryDark">@color/background</item>

        <item name="alertDialogTheme">@style/RoundedMaterialAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/RoundedMaterialAlertDialog</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.AppTheme.MainActionButton</item>
        <item name="materialSearchBarStyle">@style/Widget.Material3Expressive.SearchBar.CenteredText</item>
        <item name="preferenceTheme">@style/JamiPreferenceThemeOverlay</item>
        <item name="popupMenuBackground">@drawable/custom_popup_background</item>
        <item name="materialSwitchStyle">@style/CustomMaterialSwitch</item>
        <item name="textInputOutlinedStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="textInputFilledStyle">@style/Widget.Jami.TextInputLayout</item>

        <!-- joma -->
        <item name="android:fontFamily">@font/joma_mono</item>
        <item name="fontFamily">@font/joma_mono</item>
        <item name="colorSurfaceContainerLowest">@color/joma_surface_lowest</item>
        <item name="colorSurfaceContainerLow">@color/joma_surface_low</item>
        <item name="colorSurfaceContainer">@color/joma_surface</item>
        <item name="colorSurfaceContainerHigh">@color/joma_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/joma_surface_highest</item>
        <item name="colorSurfaceVariant">@color/joma_surface</item>
        <item name="colorOnSurfaceVariant">@color/joma_on_surface_variant</item>
        <item name="colorOutline">@color/joma_outline</item>
        <item name="colorOutlineVariant">@color/joma_outline_variant</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Joma.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Joma.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Joma.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Joma.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Joma.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Joma.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Joma.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Joma.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Joma.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Joma.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Joma.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Joma.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Joma.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Joma.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Joma.LabelSmall</item>
    </style>

    <!-- Jami forces a light theme on the account wizard; joma's is the same as the rest. -->
    <style name="AppThemeBase.Light" parent="AppThemeBase" />

    <!-- Jami's dark theme for calls and the media viewer, with the terminal font. -->
    <style name="AppThemeBase.Dark" parent="@style/Theme.Material3Expressive.Dark.NoActionBar">
        <item name="android:colorBackground">@color/black</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorSecondary">@color/color_primary_light</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorPrimaryContainer">@color/colorPrimary</item>
        <item name="colorOnPrimaryContainer">@color/background</item>
        <item name="android:windowContentTransitions">true</item>
        <!-- joma -->
        <item name="android:fontFamily">@font/joma_mono</item>
        <item name="fontFamily">@font/joma_mono</item>
    </style>

    <style name="TextAppearance.Joma.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge"><item name="fontFamily">@font/joma_mono</item><item name="android:fontFamily">@font/joma_mono</item></style>
    <style name="TextAppearance.Joma.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium"><item name="fontFamily">@font/joma_mono</item><item name="android:fontFamily">@font/joma_mono</item></style>
    <style name="TextAppearance.Joma.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall"><item name="fontFamily">@font/joma_mono</item><item name="android:fontFamily">@font/joma_mono</item></style>
    <style name="TextAppearance.Joma.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge"><item name="fontFamily">@font/joma_mono</item><item name="android:fontFamily">@font/joma_mono</item></style>
    <style name="TextAppearance.Joma.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium"><item name="fontFamily">@font/joma_mono</item><item name="android:fontFamily">@font/joma_mono</item></style>
    <style name="TextAppearance.Joma.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall"><item name="fontFamily">@font/joma_mono</item><item name="android:fontFamily">@font/joma_mono</item></style>
    <style name="TextAppearance.Joma.TitleLarge" parent="TextAppearance.Material3.TitleLarge"><item name="fontFamily">@font/joma_mono</item><item name="android:fontFamily">@font/joma_mono</item></style>
    <style name="TextAppearance.Joma.TitleMedium" parent="TextAppearance.Material3.TitleMedium"><item name="fontFamily">@font/joma_mono</item><item name="android:fontFamily">@font/joma_mono</item></style>
    <style name="TextAppearance.Joma.TitleSmall" parent="TextAppearance.Material3.TitleSmall"><item name="fontFamily">@font/joma_mono</item><item name="android:fontFamily">@font/joma_mono</item></style>
    <style name="TextAppearance.Joma.BodyLarge" parent="TextAppearance.Material3.BodyLarge"><item name="fontFamily">@font/joma_mono</item><item name="android:fontFamily">@font/joma_mono</item></style>
    <style name="TextAppearance.Joma.BodyMedium" parent="TextAppearance.Material3.BodyMedium"><item name="fontFamily">@font/joma_mono</item><item name="android:fontFamily">@font/joma_mono</item></style>
    <style name="TextAppearance.Joma.BodySmall" parent="TextAppearance.Material3.BodySmall"><item name="fontFamily">@font/joma_mono</item><item name="android:fontFamily">@font/joma_mono</item></style>
    <style name="TextAppearance.Joma.LabelLarge" parent="TextAppearance.Material3.LabelLarge"><item name="fontFamily">@font/joma_mono</item><item name="android:fontFamily">@font/joma_mono</item></style>
    <style name="TextAppearance.Joma.LabelMedium" parent="TextAppearance.Material3.LabelMedium"><item name="fontFamily">@font/joma_mono</item><item name="android:fontFamily">@font/joma_mono</item></style>
    <style name="TextAppearance.Joma.LabelSmall" parent="TextAppearance.Material3.LabelSmall"><item name="fontFamily">@font/joma_mono</item><item name="android:fontFamily">@font/joma_mono</item></style>
</resources>
