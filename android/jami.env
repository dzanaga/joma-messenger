# The Jami Android client and daemon joma for Android is built on, pinned to reviewed
# revisions (like gliff's crates). Bump both together: the client pins its daemon as a
# submodule, but that pin can lag: the daemon here is the last one before the
# client's commit (2026-11-23), which has the APIs the client calls (contact
# metadata, conferenceInfosUpdated); the submodule's e62dfcb (2026-11-06) has not.
JAMI_ANDROID_URL=https://github.com/savoirfairelinux/jami-client-android.git
JAMI_ANDROID_REV=91b77591145567fa9e48408df16fd54b905b97fd
JAMI_DAEMON_URL=https://github.com/savoirfairelinux/jami-daemon.git
JAMI_DAEMON_REV=74fcdfa97f17467d6727fcefb368a04b7de23e3a
